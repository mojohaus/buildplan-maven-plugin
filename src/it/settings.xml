<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings for the child builds. Without a settingsFile, maven-invoker-plugin forwards the active profiles of the outer build (run-its) to every child build, which logs a warning because the ITs do not define that profile. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd">
</settings>
